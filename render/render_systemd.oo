// # Systemd & Quadlet Configuration Renderer
//
// Logline: Generates systemd drop-in unit overrides and Podman Quadlet configuration snippets.
//
// Setup: Strictly complies with Fedora Server conventions and systemd unit drop-in standards.
//
// Beats:
//   1. Render systemd EnvironmentFile key-value definition files.
//   2. Generate service drop-in overrides for packaged system units.
//   3. Produce container environment blocks for Podman Quadlets.
//   4. Validate variable escaping for systemd unit directive parser safety.

import "core/env_types.oo";

pub fn render_systemd_env_file(vars: List[EnvVar]) -> String {
    let mut out: String = "# Generated by ooenv v0.2.0 (openOODA sovereign environment controller)\n";
    out = out + "# Standard EnvironmentFile definition for systemd services\n\n";

    let n: Int = list_len(vars);
    let mut i: Int = 0;
    while i < n {
        let v: EnvVar = list_get(vars, i);
        out = out + v.key + "=\"" + v.val + "\"\n";
        i = i + 1;
    }
    return out;
}

pub fn render_systemd_dropin(vars: List[EnvVar], unit_name: String) -> String {
    let target_unit: String = if unit_name == "" { "service" } else { unit_name };
    let mut out: String = "# Generated by ooenv v0.2.0 (openOODA sovereign environment controller)\n";
    out = out + "# Drop-in override target: /etc/systemd/system/" + target_unit + ".service.d/50-env.conf\n\n";
    out = out + "[Service]\n";

    let n: Int = list_len(vars);
    let mut i: Int = 0;
    while i < n {
        let v: EnvVar = list_get(vars, i);
        out = out + "Environment=\"" + v.key + "=" + v.val + "\"\n";
        i = i + 1;
    }
    return out;
}

pub fn render_quadlet_env(vars: List[EnvVar], container_name: String) -> String {
    let target: String = if container_name == "" { "app" } else { container_name };
    let mut out: String = "# Generated by ooenv v0.2.0 (Podman Quadlet Environment Block)\n";
    out = out + "# Target: /etc/containers/systemd/" + target + ".container\n\n";
    out = out + "[Container]\n";

    let n: Int = list_len(vars);
    let mut i: Int = 0;
    while i < n {
        let v: EnvVar = list_get(vars, i);
        out = out + "Environment=" + v.key + "=" + v.val + "\n";
        i = i + 1;
    }
    return out;
}
