// # Synthetic Environment Generation & Transformation
//
// Logline: Deterministic test fixtures, transformation pipelines, and environment differential calculations.
//
// Setup: Pure state transformers executing capability-bounded environment modifications.
//
// Beats:
//   1. Generate baseline POSIX, production service, and security-stressed environments.
//   2. Apply unsetting, ignoring, and overriding transformations.
//   3. Filter environment variables by key prefix.
//   4. Calculate precise structural diffs between baseline and modified states.

import "core/env_types.oo";

pub fn build_posix_base_env() -> List[EnvVar] {
    let mut vars: List[EnvVar] = list_new();
    vars = list_push(vars, make_env_var("HOME", "/home/sovereign", false));
    vars = list_push(vars, make_env_var("LANG", "en_US.UTF-8", false));
    vars = list_push(vars, make_env_var("LOGNAME", "sovereign", false));
    vars = list_push(vars, make_env_var("PATH", "/usr/local/bin:/usr/bin:/bin", false));
    vars = list_push(vars, make_env_var("SHELL", "/bin/oosh", false));
    vars = list_push(vars, make_env_var("TERM", "xterm-256color", false));
    vars = list_push(vars, make_env_var("USER", "sovereign", false));
    return vars;
}

